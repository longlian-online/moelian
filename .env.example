# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Nuxt session encryption secret (use a long random value in local/deployed environments)
NUXT_SESSION_PASSWORD="replace-with-a-long-random-secret"

# Tencent Cloud COS
NUXT_STORAGE_COS_SECRET_ID="replace-with-cos-secret-id"
NUXT_STORAGE_COS_SECRET_KEY="replace-with-cos-secret-key"
NUXT_STORAGE_COS_BUCKET="replace-with-cos-bucket"
NUXT_STORAGE_COS_REGION="ap-guangzhou"
NUXT_STORAGE_COS_URL="https://example.cos.ap-guangzhou.myqcloud.com"
NUXT_STORAGE_COS_DOMAIN=""

# NATS JetStream
NUXT_NATS_SERVER="localhost:4222"
NUXT_NATS_TOKEN="replace-with-nats-token"

# Optional public site configuration
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
